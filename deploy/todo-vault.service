# Personal Todo Vault systemd 服务模板
# install.sh 会按实际安装路径自动生成此文件到 /etc/systemd/system/todo-vault.service，
# 本文件仅作参考，一般无需手动修改。
#
# 常用命令：
#   systemctl status todo-vault       查看状态
#   journalctl -u todo-vault -f       实时日志
#   sudo systemctl restart todo-vault
#   sudo systemctl stop todo-vault
#   sudo systemctl disable todo-vault

[Unit]
Description=Personal Todo Vault
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 服务运行用户，可改为专用用户
User=root
WorkingDirectory=/opt/todo-vault
# 配置从同目录 .env 注入（HOST、CONSOLE_TOKEN 等）
EnvironmentFile=/opt/todo-vault/.env
ExecStart=/root/.local/nodejs/bin/node /opt/todo-vault/server.js
# 崩溃后自动重启（3 秒后重试）
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
